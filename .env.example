# Conexao com o broker MQTT.
# ATENCAO: variaveis com prefixo VITE_ sao embutidas no bundle do navegador
# em texto puro. Nao use aqui credenciais de um broker com permissao de
# escrita em topicos sensiveis — use um usuario somente-leitura.
VITE_MQTT_BROKER=wss://seu-broker:8884/mqtt
VITE_MQTT_USER=usuario
VITE_MQTT_PASSWORD=senha
VITE_MQTT_TOPIC=aquario/status
