# ATENCAO: toda variavel com prefixo VITE_ e embutida no bundle do navegador
# em texto puro. Qualquer visitante consegue le-las pelo DevTools.
# Nunca coloque aqui um segredo que nao possa ser publico.

# Conexao com o broker MQTT.
# Use um usuario SOMENTE-LEITURA. As credenciais de escrita devem ficar
# apenas no firmware do ESP32, nunca no front-end.
VITE_MQTT_BROKER=wss://seu-broker:8884/mqtt
VITE_MQTT_USER=usuario-somente-leitura
VITE_MQTT_PASSWORD=senha
VITE_MQTT_TOPIC=aquario/status

# OAuth do Google (Google Cloud Console > APIs e servicos > Credenciais).
# Crie um "ID do cliente OAuth 2.0" do tipo "Aplicativo da Web" e cadastre
# suas origens em "Origens JavaScript autorizadas", por exemplo:
#   http://localhost:5173
#   https://seu-dominio-de-producao
# O Client ID e publico por natureza; nao existe "client secret" nesse fluxo.
VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
